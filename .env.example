# Copy to .env and fill in real values. .env is git-ignored.
#
# Local dev: create this file yourself before `docker compose up`.
# Homelab prod: this file must already exist at
#   /opt/personal-site-service/.env
# created once by hand via ssh -- deploy.yml never copies it (see deploy.yml
# comments), so it survives every deploy untouched.

POSTGRES_DB=chitmon
POSTGRES_USER=chitmon_app
POSTGRES_PASSWORD=changeme

# "local" enables CORS for an Angular dev server on localhost:4200 (see CorsConfig).
# Leave unset/blank in prod.
SPRING_PROFILES_ACTIVE=local
